# Required: absolute path to your Obsidian vault (must exist, must be a directory).
# Resolved once at startup, immutable thereafter. No tool argument may override it.
OBSIDIAN_VAULT_PATH=/absolute/path/to/your/obsidian/vault

# Required: bearer token from Obsidian → Settings → Community Plugins → Local REST API.
OBSIDIAN_API_KEY=your-local-rest-api-bearer-token-here

# Optional: Local REST API base URL.
# Default uses HTTP (port 27123) — enable "Non-encrypted (HTTP) Server" in plugin settings.
# For HTTPS (port 27124, self-signed cert), use https://127.0.0.1:27124.
OBSIDIAN_BASE_URL=http://127.0.0.1:27123

# Optional: workflow mode.
# generic = public-friendly default with broad Markdown writes.
# freya = strict project-memory workflow with specialized tools.
OBSIDIAN_WORKFLOW=generic

# Optional: override write whitelist with a comma-separated pattern list.
# Example for Freya mode parity in a custom vault:
# OBSIDIAN_WRITE_PATTERNS=Projects/{slug}/PROJECT.md,Projects/{slug}/SUMMARY.md,LOGS.md
OBSIDIAN_WRITE_PATTERNS=

# Optional: append-only pattern overrides (comma-separated).
# Example: LOGS.md,Journal/*.md
OBSIDIAN_APPEND_ONLY_PATTERNS=

# Optional: log level (DEBUG, INFO, WARNING, ERROR). Token redaction applies at every level.
LOG_LEVEL=INFO
